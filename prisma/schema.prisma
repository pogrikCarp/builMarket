generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?
  smsPhone      String?
  image         String?
  role          Role      @default(USER)

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  orderProfiles OrderProfile[]
  favorites     Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Статус списания товаров заказа со склада в МойСклад (создание документа
// "Отгрузка" - см. src/lib/moysklad-orders.ts). PENDING - ещё не пробовали,
// SYNCED - отгрузка создана и остаток списан, FAILED - попытка не удалась
// (например, МойСклад временно недоступен - не блокирует сам заказ на сайте),
// SKIPPED - синхронизация не настроена (нет MOYSKLAD_TOKEN).
enum MoyskladSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  number       String      @unique
  status       OrderStatus @default(NEW)
  total        Decimal     @db.Decimal(12, 2)
  items        Json
  customerName String?
  phone        String?
  email        String?
  deliveryType String?
  paymentType  String?
  address      String?
  comment      String?
  company      String?
  inn          String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Онлайн-оплата через ЮKassa (см. src/lib/yookassa.ts). paymentOperationId хранит
  // id платежа ЮKassa - по нему уведомление о статусе перепроверяется через API
  // (GET /v3/payments/{id}), а не берётся из тела уведомления напрямую.
  paymentStatus      PaymentStatus @default(PENDING)
  paymentProvider    String?
  paymentOperationId String?       @unique
  paymentAmount      Decimal?      @db.Decimal(12, 2)
  paidAt             DateTime?

  // Списание остатков в МойСклад при оформлении заказа на сайте (см.
  // src/lib/moysklad-orders.ts и вызов syncOrderToMoysklad в /api/orders).
  moyskladSyncStatus MoyskladSyncStatus @default(PENDING)
  moyskladDemandId   String?
  moyskladSyncError  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrderProfile {
  id          String  @id @default(cuid())
  userId      String
  title       String
  fullName    String
  phone       String
  email       String?
  address     String?
  city        String?
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  name      String
  price     String?
  image     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum BannerType {
  BANNER
  PROMO
  HERO
  LOOKBOOK
  CERTIFICATE
  BRAND
}

model Banner {
  id        String     @id @default(cuid())
  type      BannerType @default(BANNER)
  title     String
  subtitle  String?
  image     String?
  link      String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Блок "Акции" на главной и в каталоге (?section=promo): администратор выбирает
// уже существующий товар МойСклад (productId) и задаёт ему предыдущую ("зачеркнутую")
// цену. Актуальная цена, фото, наличие и переход на карточку товара всегда берутся
// живыми из МойСклад (см. src/lib/promo.ts) - здесь хранится только сама привязка
// товара к акции и старая цена.
model PromoItem {
  id        String   @id @default(cuid())
  productId String   @unique
  oldPrice  Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Локальное зеркало каталога МойСклад.
//
// Раньше каждая страница сайта (каталог, карточка товара, поиск, бренды,
// наборы, sitemap) спрашивала МойСклад напрямую при КАЖДОМ заходе посетителя.
// Это и давало медленную загрузку (посетитель ждал ответа чужого API) и риск
// блокировки JSON API за частые запросы.
//
// Теперь МойСклад опрашивает только фоновый синхронизатор (см.
// src/lib/catalog-sync.ts), складывает товары/категории сюда, а фотографии - на
// диск сервера. Сайт читает исключительно эти таблицы (src/lib/catalog-db.ts),
// поэтому число запросов к МойСклад не зависит от числа посетителей.
// ---------------------------------------------------------------------------

model CatalogFolder {
  id         String   @id // id папки в МойСклад
  name       String
  pathName   String?
  href       String   @unique // meta.href - по нему строится дерево категорий
  parentHref String?
  syncedAt   DateTime @default(now())

  @@index([parentHref])
}

model CatalogProduct {
  id          String  @id // id товара в МойСклад
  entityType  String // product | variant | bundle | service | consumable
  name        String
  description String? @db.Text
  article     String?
  code        String?
  // Цена в копейках - как отдаёт МойСклад (salePrices[0].value), чтобы не
  // терять точность на дробных рублях.
  price       Int?
  // null - МойСклад не считает остаток для этого типа позиции (услуги, комплекты).
  // Именно null, а не 0, чтобы сайт не показывал "нет на складе" там, где раньше
  // остаток просто не отображался.
  quantity    Float?
  uom         String?

  folderId      String?
  folderName    String?
  folderPath    String?
  groupLabel    String?
  subgroupLabel String?

  // [{ url, thumbUrl, remoteHref, remoteThumbHref }] - url/thumbUrl это уже
  // локальные пути вида /catalog-images/..., remote* нужны только фоновой
  // синхронизации для повторной попытки, посетителям они не отдаются.
  images     Json
  // [{ name, value }] - значения атрибутов уже приведены к строке.
  attributes Json

  // Поле updated из МойСклад: по нему синхронизатор понимает, что товар
  // изменился и его картинки/атрибуты нужно перечитать, а не дёргать API зря.
  msUpdatedAt DateTime?
  // Товар пропал из выдачи МойСклад (удалён/архивирован) - с сайта убираем,
  // но запись оставляем, чтобы старые ссылки/заказы не ломались.
  archived    Boolean   @default(false)
  // name + артикул + код + атрибуты в нижнем регистре - для быстрого ILIKE-поиска.
  searchText  String    @db.Text
  syncedAt    DateTime  @default(now())

  @@index([folderId])
  @@index([archived])
  @@index([name])
}

enum CatalogSyncStatus {
  RUNNING
  OK
  FAILED
}

model CatalogSyncRun {
  id         String            @id @default(cuid())
  mode       String // full | stock | products
  status     CatalogSyncStatus @default(RUNNING)
  trigger    String? // cron | admin | order | webhook
  itemCount  Int               @default(0)
  imageCount Int               @default(0)
  error      String?
  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}

model StaticPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  published       Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RedirectType {
  PERMANENT
  TEMPORARY
}

model Redirect {
  id         String       @id @default(cuid())
  fromPath   String       @unique
  toPath     String
  type       RedirectType @default(PERMANENT)
  active     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
