generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?
  smsPhone      String?
  image         String?
  role          Role      @default(USER)

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  orderProfiles OrderProfile[]
  favorites     Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  number       String      @unique
  status       OrderStatus @default(NEW)
  total        Decimal     @db.Decimal(12, 2)
  items        Json
  customerName String?
  phone        String?
  email        String?
  deliveryType String?
  paymentType  String?
  address      String?
  comment      String?
  company      String?
  inn          String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Онлайн-оплата через ЮKassa (см. src/lib/yookassa.ts). paymentOperationId хранит
  // id платежа ЮKassa - по нему уведомление о статусе перепроверяется через API
  // (GET /v3/payments/{id}), а не берётся из тела уведомления напрямую.
  paymentStatus      PaymentStatus @default(PENDING)
  paymentProvider    String?
  paymentOperationId String?       @unique
  paymentAmount      Decimal?      @db.Decimal(12, 2)
  paidAt             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrderProfile {
  id          String  @id @default(cuid())
  userId      String
  title       String
  fullName    String
  phone       String
  email       String?
  address     String?
  city        String?
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  name      String
  price     String?
  image     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum BannerType {
  BANNER
  PROMO
  HERO
  LOOKBOOK
  CERTIFICATE
  BRAND
}

model Banner {
  id        String     @id @default(cuid())
  type      BannerType @default(BANNER)
  title     String
  subtitle  String?
  image     String?
  link      String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaticPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  published       Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RedirectType {
  PERMANENT
  TEMPORARY
}

model Redirect {
  id         String       @id @default(cuid())
  fromPath   String       @unique
  toPath     String
  type       RedirectType @default(PERMANENT)
  active     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
