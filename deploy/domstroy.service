[Unit]
Description=DomStroy Next.js application (__PORT__)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__RELEASE_DIR__
Environment=NODE_ENV=production
Environment=PORT=__PORT__
EnvironmentFile=/opt/domstroy/.env
ExecStart=/usr/bin/npx next start -p __PORT__
Restart=always
RestartSec=5
KillSignal=SIGTERM
SyslogIdentifier=domstroy-__PORT__

[Install]
WantedBy=multi-user.target
